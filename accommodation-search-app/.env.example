# انسخ هذا الملف إلى .env واملأ بياناتك الحقيقية من Booking.com Partner Hub
# لا ترفع ملف .env إلى Git أبدًا — يحتوي على مفاتيح سرية

# بيئة Sandbox (اختبار) أو Production (فعلية)
BOOKING_API_BASE=https://demandapi-sandbox.booking.com/3.2

# رقم هوية الشريك (Affiliate ID)
BOOKING_AFFILIATE_ID=your_affiliate_id_here

# التوكن السري (Bearer Token)
BOOKING_BEARER_TOKEN=your_bearer_token_here

# منفذ تشغيل السيرفر المحلي
PORT=4000
